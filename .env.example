# Environment Configuration Example for EB Accounting Platform

# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only)
GEMINI_API_KEY=

# APP_URL: The URL where this app is hosted
APP_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eb_accounting_prod?schema=public

# JWT Secrets (Minimum 32 characters each)
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string_in_production

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eb_accounting_prod

# Application Mode
NODE_ENV=production
